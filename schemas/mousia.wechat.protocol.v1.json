{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mousia.dev/schemas/wechat/protocol/v1.json",
  "title": "Mousia WeChat Local Interface Protocol v1",
  "description": "Language-neutral request and response envelopes for a read-only local WeChat source.",
  "$defs": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "description": "RFC 3339 timestamp with timezone, normally UTC with a Z suffix.",
      "format": "date-time"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "request_id", "operation", "params"],
      "properties": {
        "protocol_version": {"const": "mousia.wechat.protocol.v1"},
        "request_id": {"$ref": "#/$defs/requestId"},
        "source_id": {"$ref": "#/$defs/sourceId"},
        "operation": {
          "type": "string",
          "enum": [
            "status",
            "contacts.list",
            "conversations.list",
            "official.list",
            "groups.members",
            "contacts.groups",
            "groups.common",
            "relationships.list",
            "messages.read",
            "messages.search",
            "messages.export",
            "favorites.list",
            "favorites.search",
            "favorites.export",
            "moments.list",
            "moments.search",
            "moments.export",
            "search.all"
          ]
        },
        "params": {"type": "object"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_json",
            "invalid_request",
            "invalid_argument",
            "protocol_version_mismatch",
            "source_mismatch",
            "unsupported_operation",
            "source_changed",
            "not_found",
            "internal_error"
          ]
        },
        "message": {"type": "string"},
        "details": {"type": "object"}
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "schema_version", "request_id", "source_id", "operation", "snapshot"],
      "properties": {
        "protocol_version": {"const": "mousia.wechat.protocol.v1"},
        "schema_version": {"const": "mousia.wechat.v0"},
        "request_id": {"type": ["string", "null"]},
        "source_id": {"$ref": "#/$defs/sourceId"},
        "operation": {"type": ["string", "null"]},
        "snapshot": {"type": ["string", "null"]}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "meta"],
      "properties": {
        "ok": {"type": "boolean"},
        "data": {},
        "error": {"$ref": "#/$defs/error"},
        "meta": {"$ref": "#/$defs/meta"}
      },
      "oneOf": [
        {
          "properties": {"ok": {"const": true}},
          "required": ["data"],
          "not": {"required": ["error"]}
        },
        {
          "properties": {"ok": {"const": false}},
          "required": ["error"],
          "not": {"required": ["data"]}
        }
      ]
    }
  },
  "$ref": "#/$defs/request"
}

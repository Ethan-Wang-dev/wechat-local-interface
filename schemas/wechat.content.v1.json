{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ethan-Wang-dev/wechat-local-interface/main/schemas/wechat.content.v1.json",
  "title": "WeChat Skill Content Envelope v1",
  "description": "Optional envelope for passing analysis results and file artifacts between Skills.",
  "type": "object",
  "required": ["schema", "kind", "payload"],
  "properties": {
    "schema": {"const": "wechat.content.v1"},
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "Skill-defined semantic name for the result."
    },
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "payload": {
      "description": "Skill-defined content. It may be any JSON value.",
      "type": ["object", "array", "string", "number", "boolean", "null"]
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "provenance": {"type": "object"},
    "analysis": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "object"},
        "excerpt": {"type": "string"},
        "message_id": {"type": "string"},
        "timestamp": {"type": "string"}
      },
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["path", "media_type"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
